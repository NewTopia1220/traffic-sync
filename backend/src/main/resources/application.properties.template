spring.application.name=traffic-sync
server.port=8080
spring.profiles.include=local

# ===== V2X API =====
v2x.api.crossroad-url=https://apis.data.go.kr/B551982/rti/crsrd_map_info
v2x.api.signal-url=https://apis.data.go.kr/B551982/rti/tl_drct_info
v2x.api.service-key=${V2X_API_SERVICE_KEY:}
v2x.api.num-of-rows=1000

# ===== Kakao Map =====
kakao.map.app-key=${KAKAO_MAP_APP_KEY:}

# ===== Jamsil PoC =====
jamsil.lat=37.5133
jamsil.lon=127.1002
jamsil.radius-km=1.0

# ===== Polling interval (ms) =====
traffic.poll.interval-ms=10000

# ===== External context APIs =====
kma.api.url=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
kma.api.service-key=${KMA_API_SERVICE_KEY:}
kma.api.num-of-rows=1000
weather.poll.interval-ms=600000

topis.api.base-url=http://openapi.seoul.go.kr:8088
topis.api.service-key=${TOPIS_API_SERVICE_KEY:}
topis.api.speed-service-name=TrafficInfo
topis.api.vertex-service-name=LinkVerInfo
topis.api.road-div-service-name=RoadDivInfo
topis.api.road-info-service-name=RoadInfo
topis.api.axis-link-service-name=LinkWithLoad
topis.api.response-format=xml
topis.api.page-size=1000
topis.api.vertex-max-pages=50
topis.api.master-max-pages=200
topis.api.request-timeout-seconds=6
topis.master.auto-sync-on-startup=true
topis.link-vertex.file=classpath:data/topis-link-vertex-2025.xlsx
topis.link-vertex.prefer-file=true
topis.vertex.source-proj4=+proj=tmerc +lat_0=38 +lon_0=127 +k=1 +x_0=200000 +y_0=500000 +ellps=GRS80 +units=m +no_defs
topis.speed.poll.interval-ms=60000
topis.speed.refresh.max-concurrency=4
topis.speed.refresh.max-wait-ms=12000
topis.route-traffic.max-match-distance-meters=90
topis.route-traffic.max-bearing-diff-degrees=45
topis.route-traffic.max-links-per-direction=1
topis.route-traffic.master-cache-ttl-ms=60000

road-link.max-match-distance-meters=150
road-link.mapping.interval-ms=86400000

road-risk.api.url=http://apis.data.go.kr/B552061/roadDgdgrLink/getRestRoadDgdgrLink
road-risk.api.service-key=${ROAD_RISK_API_SERVICE_KEY:}
road-risk.vehicle-type=01
road-risk.api.num-of-rows=10
road-risk.api.request-timeout-seconds=6
road-risk.local-line-length-meters=60
road-risk.poll.interval-ms=900000
road-risk.refresh.max-per-run=20
road-risk.refresh.max-concurrency=1
road-risk.refresh.min-age-ms=900000
road-risk.refresh.stop-after-failures=3
road-risk.refresh.on-area-change=false

# ===== Logging =====
logging.level.com.example.demo.service.V2xApiService=INFO
